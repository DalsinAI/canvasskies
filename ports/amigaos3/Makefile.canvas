AMIGA_STOVE ?= $(HOME)/AmiCradle/stoves/os32-gcc16
PREFIX := $(AMIGA_STOVE)/prefix
SYSROOT := $(PREFIX)/m68k-amigaos
CC := $(PREFIX)/bin/m68k-amigaos-gcc
OUT := build-canvas-skies/CanvasSkies
SRC := src/modern/canvas_skies.c
HDR := src/modern/canvas_campaign.h

CFLAGS := -std=gnu99 -O2 -Wall -Wextra -m68040 -m68881 -noixemul \
	-fno-delete-null-pointer-checks -I$(SYSROOT)/include/SDL2 \
	-DCANVAS_TITLE_BMP=\"PROGDIR:assets/canvas-skies/title.bmp\" \
	-DCANVAS_TITLE_BANNER_BMP=\"PROGDIR:assets/canvas-skies/title-banner.bmp\" \
	-DCANVAS_BOARD_BMP=\"PROGDIR:assets/canvas-skies/mission-board-v2.bmp\" \
	-DCANVAS_FATAL_MEMORIAL_BMP=\"PROGDIR:assets/canvas-skies/fatal-memorial-wide.bmp\" \
	-DCANVAS_FIELD_HOSPITAL_BMP=\"PROGDIR:assets/canvas-skies/field-hospital.bmp\" \
	-DCANVAS_JOURNAL_BMP=\"PROGDIR:assets/canvas-skies/journal.bmp\" \
	-DCANVAS_SKY_BMP=\"PROGDIR:assets/canvas-skies/sky.bmp\" \
	-DCANVAS_BATTLEFIELD_BMP=\"PROGDIR:assets/canvas-skies/hills.bmp\" \
	-DCANVAS_FOREGROUND_BMP=\"PROGDIR:assets/canvas-skies/foreground-panorama.bmp\" \
	-DCANVAS_MID_FARM_BMP=\"PROGDIR:assets/canvas-skies/mid-farm.bmp\" \
	-DCANVAS_MID_CHURCH_BMP=\"PROGDIR:assets/canvas-skies/mid-church.bmp\" \
	-DCANVAS_MID_POPLARS_BMP=\"PROGDIR:assets/canvas-skies/mid-poplars.bmp\" \
	-DCANVAS_MID_SMOKE_BMP=\"PROGDIR:assets/canvas-skies/mid-smoke.bmp\" \
	-DCANVAS_MID_TELEGRAPH_BMP=\"PROGDIR:assets/canvas-skies/mid-telegraph.bmp\" \
	-DCANVAS_MID_WALL_BMP=\"PROGDIR:assets/canvas-skies/mid-wall.bmp\" \
	-DCANVAS_NEAR_CRATER_BMP=\"PROGDIR:assets/canvas-skies/near-crater.bmp\" \
	-DCANVAS_NEAR_TRENCH_BMP=\"PROGDIR:assets/canvas-skies/near-trench.bmp\" \
	-DCANVAS_NEAR_TREE_BMP=\"PROGDIR:assets/canvas-skies/near-tree.bmp\" \
	-DCANVAS_NEAR_WIRE_BMP=\"PROGDIR:assets/canvas-skies/near-wire.bmp\" \
	-DCANVAS_NEAR_ROAD_BMP=\"PROGDIR:assets/canvas-skies/near-road.bmp\" \
	-DCANVAS_NEAR_MOUND_BMP=\"PROGDIR:assets/canvas-skies/near-mound.bmp\" \
	-DCANVAS_MACHINE_GUN_BMP=\"PROGDIR:assets/canvas-skies/ground-machine-gun.bmp\" \
	-DCANVAS_AA_GUN_BMP=\"PROGDIR:assets/canvas-skies/ground-aa-gun.bmp\" \
	-DCANVAS_TOPDOWN_BATTLEFIELD_BMP=\"PROGDIR:assets/canvas-skies/topdown-battlefield.bmp\" \
	-DCANVAS_TOPDOWN_PLAYER_BMP=\"PROGDIR:assets/canvas-skies/topdown-player.bmp\" \
	-DCANVAS_DOGFIGHT_BACKGROUND_BMP=\"PROGDIR:assets/canvas-skies/dogfight-panorama-v2.bmp\" \
	-DCANVAS_DOGFIGHT_ENEMY_BMP=\"PROGDIR:assets/canvas-skies/dogfight-enemy-headon.bmp\" \
	-DCANVAS_PILOT_COCKPIT_BMP=\"PROGDIR:assets/canvas-skies/pilot-cockpit.bmp\" \
	-DCANVAS_PILOT_COCKPIT_UNARMED_BMP=\"PROGDIR:assets/canvas-skies/pilot-cockpit-unarmed.bmp\" \
	-DCANVAS_GUNNER_COCKPIT_BMP=\"PROGDIR:assets/canvas-skies/gunner-cockpit.bmp\" \
	-DCANVAS_GUNNER_RING_BMP=\"PROGDIR:assets/canvas-skies/gunner-ring-empty-v2.bmp\" \
	-DCANVAS_GUNNER_AIRFRAME_BMP=\"PROGDIR:assets/canvas-skies/gunner-airframe-tail.bmp\" \
	-DCANVAS_GUNNER_MOVING_BMP=\"PROGDIR:assets/canvas-skies/gunner-single-atlas.bmp\" \
	-DCANVAS_EXPLOSION_ATLAS_BMP=\"PROGDIR:assets/canvas-skies/explosion-atlas.bmp\" \
	-DCANVAS_TOPDOWN_EXPLOSION_ATLAS_BMP=\"PROGDIR:assets/canvas-skies/topdown-explosion-atlas.bmp\" \
	-DCANVAS_DISPLAY_36X42_BMP=\"PROGDIR:assets/canvas-skies/font-display-36x42.bmp\" \
	-DCANVAS_DISPLAY_22X28_BMP=\"PROGDIR:assets/canvas-skies/font-display-22x28.bmp\" \
	-DCANVAS_DISPLAY_16X23_BMP=\"PROGDIR:assets/canvas-skies/font-display-16x23.bmp\" \
	-DCANVAS_DISPLAY_12X18_BMP=\"PROGDIR:assets/canvas-skies/font-display-12x18.bmp\" \
	-DCANVAS_TYPEWRITER_10X15_BMP=\"PROGDIR:assets/canvas-skies/font-typewriter-10x15.bmp\" \
	-DCANVAS_TYPEWRITER_7X11_BMP=\"PROGDIR:assets/canvas-skies/font-typewriter-7x11.bmp\" \
	-DCANVAS_JOURNAL_8X12_BMP=\"PROGDIR:assets/canvas-skies/font-journal-8x12.bmp\" \
	-DCANVAS_PLAYER_SPRITES_BMP=\"PROGDIR:assets/canvas-skies/aircraft-player.bmp\" \
	-DCANVAS_ENEMY_SPRITES_BMP=\"PROGDIR:assets/canvas-skies/aircraft-enemy.bmp\" \
	-DCANVAS_MARCH_WAV=\"PROGDIR:assets/canvas-skies/washington-post-gramophone.wav\" \
	-DCANVAS_MESS_WAV=\"PROGDIR:assets/canvas-skies/colonel-bogey-gramophone.wav\" \
	-DCANVAS_PIPER_WAV=\"PROGDIR:assets/canvas-skies/amazing-grace-bagpipes.wav\" \
	-DCANVAS_TIPPERARY_WAV=\"PROGDIR:assets/canvas-skies/tipperary-gramophone.wav\" \
	-DCANVAS_HOME_FIRES_WAV=\"PROGDIR:assets/canvas-skies/home-fires-gramophone.wav\" \
	-DCANVAS_KIT_BAG_WAV=\"PROGDIR:assets/canvas-skies/kit-bag-gramophone.wav\" \
	-DCANVAS_HOLYROOD_WAV=\"PROGDIR:assets/canvas-skies/holyrood-gramophone.wav\" \
	-DCANVAS_VOICE_OF_THE_GUNS_WAV=\"PROGDIR:assets/canvas-skies/voice-of-the-guns-gramophone.wav\" \
	-DCANVAS_HOLST_WAV=\"PROGDIR:assets/canvas-skies/holst-second-suite-gramophone.wav\"
LDFLAGS := -m68040 -m68881 -noixemul -L$(SYSROOT)/lib
LDLIBS := -lSDL2 -lm -lamiga

.PHONY: all clean

all: $(OUT)

$(OUT): $(SRC) $(HDR)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $< $(LDLIBS)

clean:
	rm -rf build-canvas-skies

# Release drawer: the executable, icons, licences and only the assets the
# game loads at run time.  Source PNGs and unused experiments stay out.
PACKAGE := build-canvas-skies/package/CanvasSkies
RUNTIME_ASSETS := $(sort $(patsubst PROGDIR:%,%,$(filter PROGDIR:%,$(subst \", ,$(subst =, ,$(CFLAGS))))))

.PHONY: package
package: $(OUT)
	rm -rf $(PACKAGE)
	mkdir -p $(PACKAGE)/assets/canvas-skies
	cp $(OUT) $(PACKAGE)/CanvasSkies
	cp "ports/amigaos3/package/Start Canvas Skies" "ports/amigaos3/package/Start Canvas Skies.info" $(PACKAGE)/
	cp ports/amigaos3/package/Drawer.info build-canvas-skies/package/CanvasSkies.info
	cp $(RUNTIME_ASSETS) $(PACKAGE)/assets/canvas-skies/
	cp LICENSE README.md assets/canvas-skies/MUSIC_LICENSE.md \
	   assets/canvas-skies/ART_PROVENANCE.md \
	   assets/canvas-skies/Liberation-font-copyright.txt \
	   assets/canvas-skies/Noto-font-copyright.txt $(PACKAGE)/
